# ========================================================
# Civic Connect - Backend Environment Variables
# ========================================================
# Instructions:
# 1. Duplicate this file and rename it to '.env'
# 2. Fill in your own values below.
# 3. DO NOT commit your actual '.env' file to Git.
# ========================================================

# Port for Express API server
PORT=4000

# Google Gemini AI API Key
# Required for AI image analysis, classification & "Vidhya" chatbot
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
